{
  "manifest_version": 3,
  "name": "YouTube Transcript Q&A (Local)",
  "version": "1.0.0",
  "description": "Ask questions about a YouTube video using its transcript and a local RAG server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask about this YouTube video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"]
}
